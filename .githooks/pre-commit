#!/bin/sh
# Blocks a commit when a staged file or path holds private information; see scripts/leak-check.sh.
root=$(git rev-parse --show-toplevel)
check="$root/scripts/leak-check.sh"

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

status=0
printf '%s\n' "$files" | "$check" --label "staged paths" || status=1
while IFS= read -r f; do
  git show ":$f" | "$check" --label "$f" || status=1
done <<EOT
$files
EOT

[ "$status" -eq 0 ] || echo "pre-commit: private information found; nothing was committed." >&2
exit "$status"

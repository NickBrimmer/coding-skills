#!/bin/sh
# Blocks a push when outgoing commits add private information; see scripts/leak-check.sh.
root=$(git rev-parse --show-toplevel)
check="$root/scripts/leak-check.sh"
zero=0000000000000000000000000000000000000000

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # Only added lines and messages: a commit that removes a private term must still push.
  {
    git log --format='%s%n%b' $range
    git log -p --format= $range | grep '^+' | grep -v '^+++'
  } | "$check" --label "push $local_ref" || status=1
done

[ "$status" -eq 0 ] || echo "pre-push: private information found; nothing was pushed." >&2
exit "$status"
